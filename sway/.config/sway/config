# =========================================================
# Sway Core Configuration (Fedora)
# =========================================================

# --- Variables ---
set $mod Mod4
set $term alacritty
set $menu wofi --show run
set $left h
set $down j
set $up k
set $right l

# --- Output & Wallpaper ---
# Use 'swaymsg -t get_outputs' to find your identifier
output * bg ~/Pictures/wallpaper.png fill

# --- Input Configuration ---
input "type:keyboard" {
    xkb_layout us
    xkb_options caps:escape
}

# --- Essential Startup Daemons (O(1) Execution) ---
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec gnome-keyring-daemon --start --components=pkcs11,secrets,ssh
exec mako
exec waybar

# UI for sudo-prompts in graphical applications
exec /usr/libexec/polkit-kde-authentication-agent-1

# Automatic mount for USB-sticks (show in tray / Waybar)
exec udiskie --tray

# --- Keybindings: Applications ---
bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -b 'Yes' 'swaymsg exit'

# --- Keybindings: Movement (Vim Style) ---
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# --- Workspaces ---
# bindcode (keycodes 10-18 = number keys 1-9) works with both the plain us layout
# and the optional numswap layout (see README, "Num row swap").
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+15 workspace number 6
bindcode $mod+16 workspace number 7
bindcode $mod+17 workspace number 8
bindcode $mod+18 workspace number 9

bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5
bindcode $mod+Shift+15 move container to workspace number 6
bindcode $mod+Shift+16 move container to workspace number 7
bindcode $mod+Shift+17 move container to workspace number 8
bindcode $mod+Shift+18 move container to workspace number 9



# =========================================================
# Additional Startup Daemons
# =========================================================
# NetworkManager applet for Waybar system tray
exec nm-applet --indicator

# =========================================================
# System Administration Keybindings
# =========================================================
# Hot-reload the configuration file in O(1) time
bindsym $mod+Shift+c reload

# Lock the screen securely
bindsym $mod+Escape exec swaylock -c 000000

# =========================================================
# Screenshot Workflow (Wayland Native)
# =========================================================
# Select an area and copy it directly to the clipboard
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

# Take a full screen screenshot and save it to the Pictures folder
bindsym Print exec grim ~/Pictures/screenshot_$(date +'%Y%m%d_%H%M%S').png

# --- Layout Controls ---
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# --- Hardware Keys (Pipewire/Light) ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# --- Appearance ---
default_border pixel 0
gaps inner 10
gaps outer 5

# Resize Mode
# =========================================================
mode "resize" {
    # Vim-style resizing
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# =========================================================
# Scratchpad Workflow
# =========================================================
# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the current floating scratchpad
bindsym $mod+minus scratchpad show

# Load machine-specific hardware overrides (Optional)
include ~/.config/sway/conf.d/*.conf
