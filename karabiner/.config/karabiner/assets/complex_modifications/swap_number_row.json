{
  "title": "Swap Numbers and Symbols (Complete Number Row)",
  "rules": [
    {
      "description": "Swap 1 and ! (Exclamation Mark)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": { "mandatory": ["shift"] }
          },
          "to": [ { "key_code": "1" } ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": { "optional": ["caps_lock"] }
          },
          "to": [ { "key_code": "1", "modifiers": ["left_shift"] } ]
        }
      ]
    },
    {
